# Settings for the quadit service (quadit.service). Restart it after a change:
#   sudo systemctl restart quadit
# Every setting is in https://github.com/agrigoryan/quadit/blob/main/docs/install.md

# The address people use to reach the server. Links in mail and passkeys need it.
#QUADIT_BASE_URL=https://quadit.example.com

# Where it listens. The default is :4780 on every interface.
#QUADIT_LISTEN=:4780

# HTTPS with a certificate from Let's Encrypt; ports 443 and 80 must reach this machine.
#QUADIT_TLS_DOMAIN=quadit.example.com
#QUADIT_LISTEN=:443

# Postgres instead of SQLite in /var/lib/quadit.
#QUADIT_DB=postgres://quadit:secret@localhost:5432/quadit

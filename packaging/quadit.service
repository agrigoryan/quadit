# Quadit as a system service, installed by the .deb and .rpm packages and
# not started by them. Settings go in /etc/quadit/quadit.env.
#
#   sudo systemctl enable --now quadit

[Unit]
Description=Quadit: tasks, decisions and docs for people and AI agents
Documentation=https://github.com/agrigoryan/quadit/blob/main/docs/install.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quadit
Group=quadit
Environment=QUADIT_DATA=/var/lib/quadit
EnvironmentFile=-/etc/quadit/quadit.env
WorkingDirectory=/var/lib/quadit
ExecStart=/usr/bin/quadit serve
Restart=on-failure
RestartSec=5
# Lets --tls-domain take ports 443 and 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/quadit

[Install]
WantedBy=multi-user.target

  "type": "paragraph",
  "updated_by": "<@aram>",
  "updated_seq": 164
 },
 {
  "content": [
   {
    "text": "confidential, about SVA-5",
    "type": "text"
   }
  ],
  "created_by": "<@aram>",
  "created_seq": 165,
  "doc_id": "<doc Salary notes>",
  "id": "<id #315>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@aram>",
  "updated_seq": 165
 },
 {
  "content": [
   {
    "text": "between us, about SVA-2",
    "type": "text"
   }
  ],
  "created_by": "<@aram>",
  "created_seq": 166,
  "doc_id": "<doc For Bea>",
  "id": "<id #317>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@aram>",
  "updated_seq": 166
 },
 {
  "content": [
   {
    "text": "mine",
    "type": "text"
   }
  ],
  "created_by": "<@bea>",
  "created_seq": 167,
  "doc_id": "<doc Bea's own>",
  "id": "<id #435>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@bea>",
  "updated_seq": 167
 },
 {
  "content": [
   {
    "text": "The boss has four phases.",
    "type": "text"
   }
  ],
  "created_by": "<@aram>",
  "created_seq": 168,
  "doc_id": "<doc SVA design>",
  "id": "<id #319>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@aram>",
  "updated_seq": 168
 },
 {
  "content": [
   {
    "text": "It walks.",
    "type": "text"
   }
  ],
  "created_by": "<@aram>",
  "created_seq": 169,
  "doc_id": "<doc SVA sub-page>",
  "id": "<id #321>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@aram>",
  "updated_seq": 169
 },
 {
  "content": [
   {
    "text": "Rotate, then restart. The vault is in the cellar. Like SVA-6.",
    "type": "text"
   }
  ],
  "created_by": "<@aram>",
  "created_seq": 170,
  "doc_id": "<doc OPS runbook>",
  "id": "<id #323>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@aram>",
  "updated_seq": 170
 },
 {
  "content": [
   {
    "text": "Slowly.",
    "type": "text"
   }
  ],
  "created_by": "<@aram>",
  "created_seq": 171,
  "doc_id": "<doc OPS sub-page>",
  "id": "<id #325>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@aram>",
  "updated_seq": 171
 },
 {
  "content": [
   {
    "text": "in OPS, shared with Bea",
    "type": "text"
   }
  ],
  "created_by": "<@aram>",
  "created_seq": 172,
  "doc_id": "<doc OPS private>",
  "id": "<id #327>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@aram>",
  "updated_seq": 172
 },
 {
  "content": [
   {
    "text": "Wind up, then strike.",
    "type": "text"
   }
  ],
  "created_by": "<@aram>",
  "created_seq": 180,
  "doc_id": "<row Boss attack>",
  "id": "<id #334>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@aram>",
  "updated_seq": 180
 },
 {
  "content": [
   {
    "text": "kept, out of the way",
    "type": "text"
   }
  ],
  "created_by": "<@aram>",
  "created_seq": 189,
  "doc_id": "<doc archived>",
  "id": "<id #344>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@aram>",
  "updated_seq": 189
 },
 {
  "content": [
   {
    "text": "in the trash",
    "type": "text"
   }
  ],
  "created_by": "<@aram>",
  "created_seq": 191,
  "doc_id": "<doc removed>",
  "id": "<id #347>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@aram>",
  "updated_seq": 191
 },
 {
  "content": [
   {
    "text": "in the trash too",
    "type": "text"
   }
  ],
  "created_by": "<@aram>",
  "created_seq": 193,
  "doc_id": "<doc OPS removed>",
  "id": "<id #350>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@aram>",
  "updated_seq": 193
 },
 {
  "content": [
   {
    "text": "Reds and golds.",
    "type": "text"
   }
  ],
  "created_by": "<@artist>",
  "created_seq": 202,
  "doc_id": "<id #362>",
  "id": "<id #363>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@artist>",
  "updated_seq": 202
 },
 {
  "content": [
   {
    "text": "Third shelf.",
    "type": "text"
   }
  ],
  "created_by": "<@ops>",
  "created_seq": 204,
  "doc_id": "<id #194>",
  "id": "<id #367>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@ops>",
  "updated_seq": 204
 },
 {
  "content": [
   {
    "text": "Where we go next.",
    "type": "text"
   }
  ],
  "created_by": "<@aram>",
  "created_seq": 205,
  "doc_id": "<doc Plans>",
  "id": "<id #369>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@aram>",
  "updated_seq": 205
 },
 {
  "content": [
   {
    "text": "Ship the boss. See SVA-1.",
    "type": "text"
   }
  ],
  "created_by": "<@aram>",
  "created_seq": 206,
  "doc_id": "<doc Plans sub-page>",
  "id": "<id #371>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@aram>",
  "updated_seq": 206
 },
 {
  "content": [
   {
    "text": "Draw phase one, as the [[Handbook]] says.",
    "type": "text"
   }
  ],
  "created_by": "<@aram>",
  "created_seq": 207,
  "doc_id": "<doc Plans sub-sub-page>",
  "id": "<id #373>",
  "rank": "00000000sg",
  "type": "paragraph",
  "updated_by": "<@aram>",
  "updated_seq": 207
 },
 {
  "content": [
   {
    "text": "Pixels, not vectors.",
    "type": "text"
   }
  ],

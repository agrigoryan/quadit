notify (member): user (required), task, message (required)
preference.create (admin): id, body (required), project, decision, labels
preference.delete (admin): id (required)
preference.update (admin): id (required), body, retired
project.create (admin): id, key (required), name (required), description, icon, color, lead, settings
project.delete (admin): id (required)
project.update (admin): id (required), key, name, description, icon, color, lead, rank, settings, archived
property.create (member): id, database, name, type, config, rank, rename_option
property.delete (member): id (required)
property.update (member): id, database, name, type, config, rank, rename_option
relation.add (member): id, task (required), type, other (required)
relation.remove (member): id (required)
resource.acquire (member): id, resource (required), task, note, minutes

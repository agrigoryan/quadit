doc.update (member): id (required), title, icon, cover, parent, rank, project, private, shared_with, archived, props
doc.write (member): doc (required), markdown, mode
epic.create (member): id, project (required), name (required), description, state, lead, color, icon, start_on, target_on, rank
epic.delete (member): id (required)
epic.restore (member): id (required)
epic.update (member): id (required), name, description, state, lead, color, icon, start_on, target_on, rank
integration.create (admin): id, kind, name, project, config, secret, active
integration.delete (admin): id (required)
integration.update (admin): id, kind, name, project, config, secret, active
label.create (member): id, name (required), color, description, project
label.delete (admin): id (required)
label.update (admin): id (required), name, color, description
link.remove (member): id (required)
link.set (member): id, task (required), kind (required), url, title, repo, ref, state, checks, data
member.add (admin): user (required), handle, role, title, scope
member.remove (admin): id (required)
member.update (admin): id (required), role, handle, title, suspended, scope

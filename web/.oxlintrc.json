// The web code-style rules (CONTRIBUTING.md) that a tool can check. Run:
// pnpm lint. A rule set to "warn" has findings still to fix: fix them, then
// turn it into "error" here.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import"],
  "categories": { "correctness": "error" },
  "env": { "browser": true, "es2023": true },
  "ignorePatterns": ["dist", "playwright-report", "test-results"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/ban-ts-comment": "error",
    "import/no-cycle": "error",
    "no-console": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          { "group": ["./*", "../*"], "message": "Import through the @/ alias." },
          {
            "group": ["@/shell/**", "@/pages/**", "@/palette/**"],
            "message": "Feature folders do not import from shell, pages or palette."
          }
        ]
      }
    ],

    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/media-has-caption": "off",

    // Prettier puts parentheses around a comma sequence; they do not make it fine.
    "no-sequences": ["error", { "allowInParentheses": false }],
    "no-unused-vars": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": { "attributes": false } }],
    "typescript/no-misused-spread": "error",
    "jsx-a11y/control-has-associated-label": "error",
    // A label's words may sit two elements in (a title and a hint, each in a span).
    "jsx-a11y/label-has-associated-control": ["error", { "depth": 3 }],

    // Warnings once, fixed one rule at a time. Where a finding stays, a disable comment says why.
    "react-hooks/exhaustive-deps": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/immutability": "error",
    "react/purity": "error",
    "react/preserve-manual-memoization": "error",
    "react/no-did-update-set-state": "error",
    "react/incompatible-library": "error",
    "jsx-a11y/prefer-tag-over-role": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/interactive-supports-focus": "error"
  },
  "overrides": [
    // The layers, bottom up: types and i18n; lib; data and hooks; nav; ui;
    // the feature folders (the base rule above); shell, pages and palette.
    // A layer may import only the layers below it, and the files of its own.
    {
      "files": ["src/types/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["./*", "../*"], "message": "Import through the @/ alias." },
              {
                "group": ["@/**", "!@/types/**", "!@/test/**"],
                "message": "types sit at the bottom: they import nothing from the rest of the app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/i18n/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["./*", "../*"], "message": "Import through the @/ alias." },
              {
                "group": ["@/**", "!@/i18n/**", "!@/test/**"],
                "message": "i18n holds the words only: it imports nothing from the rest of the app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["./*", "../*"], "message": "Import through the @/ alias." },
              {
                "group": ["@/**", "!@/types/**", "!@/i18n/**", "!@/lib/**", "!@/test/**"],
                "message": "lib knows neither the server's data, the router nor the interface: it imports only types and i18n."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/data/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["./*", "../*"], "message": "Import through the @/ alias." },
              {
                "group": ["@/**", "!@/types/**", "!@/i18n/**", "!@/lib/**", "!@/data/**", "!@/test/**"],
                "message": "data (the workspace copy and the server) sits below hooks, nav, ui and every feature."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/hooks/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["./*", "../*"], "message": "Import through the @/ alias." },
              {
                "group": ["@/**", "!@/types/**", "!@/i18n/**", "!@/lib/**", "!@/hooks/**", "!@/test/**"],
                "message": "hooks are general React hooks: they know neither the server's data nor the router."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/nav/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["./*", "../*"], "message": "Import through the @/ alias." },
              {
                "group": [
                  "@/**",
                  "!@/types/**",
                  "!@/i18n/**",
                  "!@/lib/**",
                  "!@/data/**",
                  "!@/hooks/**",
                  "!@/nav/**",
                  "!@/test/**"
                ],
                "message": "nav (the router-aware helpers) sits below ui and every feature."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["./*", "../*"], "message": "Import through the @/ alias." },
              {
                "group": [
                  "@/**",
                  "!@/types/**",
                  "!@/i18n/**",
                  "!@/lib/**",
                  "!@/data/**",
                  "!@/hooks/**",
                  "!@/nav/**",
                  "!@/ui/**",
                  "!@/test/**"
                ],
                "message": "ui sits below every feature folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shell/**", "src/pages/**", "src/palette/**", "src/app.tsx", "src/main.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": [{ "group": ["./*", "../*"], "message": "Import through the @/ alias." }] }
        ]
      }
    },
    { "files": ["src/**/*.test.{ts,tsx}", "src/test/**"], "rules": { "typescript/no-non-null-assertion": "off" } },
    {
      // The end-to-end suite drives the built product from outside; it imports none of the app.
      "files": ["e2e/**", "playwright.config.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["@/*"], "message": "End-to-end tests drive the product; they do not import the app." }
            ]
          }
        ],
        // Playwright's fixtures hand their value on with a function named use; it is not React's.
        "react/rules-of-hooks": "off",
        // A fixture that needs no other fixture still takes them as its first parameter: ({}, use).
        "no-empty-pattern": "off"
      }
    }
  ]
}

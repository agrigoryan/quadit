// The desktop app's code-style rules that a tool can check (CONTRIBUTING.md
// and the web app's .oxlintrc.json set the pattern). Run: pnpm lint.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import"],
  "categories": { "correctness": "error" },
  "env": { "node": true, "browser": true, "es2023": true },
  "ignorePatterns": ["out", "dist", "test-results", "playwright-report"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/ban-ts-comment": "error",
    "import/no-cycle": "error",
    "no-console": "error",
    "no-sequences": ["error", { "allowInParentheses": false }],
    "no-unused-vars": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-misused-spread": "error"
  },
  "overrides": [
    {
      // The app's code imports through the @/ alias; the tests, outside src, import their neighbours.
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": [{ "group": ["./*", "../*"], "message": "Import through the @/ alias." }] }
        ]
      }
    }
  ]
}
